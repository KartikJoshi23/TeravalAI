# Teraval AI Finance Assistant — environment template.
# Copy this file to assistant/.env and paste the NIM key. NEVER commit assistant/.env
# (it is git-ignored). The key is supplied by Kartik.

# NVIDIA NIM API key (OpenAI-compatible). From build.nvidia.com, format: nvapi-...
NVIDIA_NIM_API_KEY=

# NIM OpenAI-compatible endpoint (default is NVIDIA's hosted integrate endpoint).
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# NIM model id. Any OpenAI-compatible chat model NIM serves, e.g.
#   meta/llama-3.1-70b-instruct, meta/llama-3.3-70b-instruct,
#   nvidia/llama-3.1-nemotron-70b-instruct
NIM_MODEL=meta/llama-3.1-70b-instruct

# Allowed browser origins, comma-separated.
#  - Local dev/preview: the Vite ports below.
#  - Production: add your deployed frontend URL, e.g.
#      CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://teraval.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Optional regex for allowed origins (leave blank for local dev). In production on
# Render, set this to match every Vercel deployment — the stable production URL AND
# the per-commit preview URLs that rotate — without listing each one:
#   CORS_ORIGIN_REGEX=https://([a-z0-9-]+\.)*vercel\.app
CORS_ORIGIN_REGEX=
