# Teraval dashboard (frontend) — environment template. Copy to web/.env.local for
# local overrides (git-ignored). Vite only exposes vars prefixed with VITE_.

# Base URL of the FastAPI assistant backend.
#  - Local dev: leave unset — the app falls back to http://localhost:8000.
#  - Production (Vercel): set this to your deployed Render URL, WITHOUT a trailing
#    slash, e.g. https://teraval-assistant.onrender.com
#
# NOTE: Vite inlines this at BUILD time, so on Vercel it must be set as a Project
# Environment Variable (Production + Preview) BEFORE the build runs. Changing it
# later requires a redeploy. If the backend is unreachable, the assistant still
# works via its grounded offline fallback.
VITE_ASSISTANT_URL=
