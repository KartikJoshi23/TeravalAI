# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# LaTeX build artifacts (report/ — compiled on Overleaf; only main.tex is tracked)
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.pdf
report/*.fls
report/*.fdb_latexmk
report/*.synctex.gz
report/_wc.py
# Report figures are captured by the user + uploaded to Overleaf (not committed)
report/teraval-*.png

# Env / secrets (NVIDIA NIM key lives here — never commit)
.env
.env.local
**/.env
# Explicit: the provided Gen-AI Chatbot .env holds a real OpenAI key — never commit
Gen-AI Chatbot/**/.env

# Gen-AI Chatbot heavy/binary artifacts (source is kept; these are regenerable)
Gen-AI Chatbot/**/*.duckdb
Gen-AI Chatbot/**/*.zip

# Python
__pycache__/
*.pyc
# Python virtualenvs (e.g. assistant/.venv) — never commit
.venv/
venv/
**/.venv/
*.egg-info/
# Assistant secrets (explicit; also covered by **/.env above)
assistant/.env

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
# Local agent tooling (per-machine launch config etc.)
.claude/

# Logs
*.log
npm-debug.log*
